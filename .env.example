# Salin ke .env lalu isi nilai nyata. JANGAN commit .env (sudah di .gitignore).

# ===== Wajib =====
# Koneksi PostgreSQL (Prisma). Gunakan nilai nyata database produksi.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Secret auth (Auth.js). Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-char-secret

# ===== Opsional =====
# Port produksi (default 3030).
PORT=3030

# Backup/restore (lib/backup) — dijalankan via `npm run backup:run`.
BACKUP_PG_DUMP_CMD=/usr/bin/pg_dump
BACKUP_PG_DUMP_PATH=/var/backups/eps
BACKUP_PG_RESTORE_CMD=/usr/bin/pg_restore
# FULL (default) | INCREMENTAL
BACKUP_TYPE=FULL

# Dev saja: dipakai prisma migrate dev utk shadow database.
SHADOW_DATABASE_URL=
