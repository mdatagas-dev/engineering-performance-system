# ============================================================
# EPS — Environment template. Salin ke `.env` lalu isi nilai nyata.
#   cp .env.example .env
# JANGAN commit .env — file ini (template) aman di-commit.
# ============================================================

# --- Wajib ---

# Secret JWT. WAJIB kuat: `openssl rand -base64 32` (minimal 32 byte).
# Aplikasi menolak start bila kurang dari 32 byte.
AUTH_SECRET=

# Koneksi PostgreSQL (Prisma). Gunakan ?sslmode=require di produksi.
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB?sslmode=require

# --- Keamanan produksi (WAJIB di-set saat deploy) ---

# IP rate-limit login aktif HANYA bila di-set. Nilai: daftar proxy tepercaya
# dipisah koma (mis. "127.0.0.1,10.0.0.5"). Set "1" bila app di belakang
# reverse-proxy tunggal dan X-Forwarded-For boleh dipercaya.
# TANPA ini, brute-force per-IP tidak dibatasi (hanya lockout per-akun).
TRUSTED_PROXIES=

# Kirim cookie sesi hanya lewat HTTPS. WAJIB "true" di produksi
# (false = cookie bisa disadap di HTTP plain).
COOKIE_SECURE=true

# --- Opsional ---

# Port aplikasi (Next dev default 3050; Docker image 3030).
PORT=3050

# Jalur utilitas pg_dump/pg_restore untuk backup (default: tersedia di PATH).
# BACKUP_PG_DUMP_PATH=pg_dump
# BACKUP_PG_RESTORE_PATH=pg_restore
