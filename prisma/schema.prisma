// Engineering Performance System — auth & RBAC schema (phase 1, backend layer)
// Provider: postgresql (Supabase). Modular: new V2 modules (Quality, Process, IoT)
// only add new models — nothing here needs to change.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LayoutType {
  DASHBOARD
  TV
}

enum NotificationType {
  KPI_ALERT
  APPROVAL_REQUEST
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum RecordStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
  LOCKED
}

enum ImportStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  ENGINEERING_MANAGER
  ENGINEERING_STAFF
  VIEWER
}

enum HealthStatus {
  UP
  DEGRADED
  DOWN
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum BackupType {
  FULL
  INCREMENTAL
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  name               String
  isActive           Boolean   @default(true) @map("is_active")
  rememberMe         Boolean   @default(false) @map("remember_me")
  failedLoginAttempts Int     @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime? @map("locked_until")
  lockoutCount       Int       @default(0) @map("lockout_count")
  lastLoginAt        DateTime? @map("last_login_at")
  areaId             String?   @map("area_id") @db.Uuid
  area               Area?     @relation(fields: [areaId], references: [id])
  userRoles          UserRole[]
  auditLogs          AuditLog[]
  dashboardLayout    DashboardLayout?
  kpiUpdatedBy       KpiConfig[] @relation("KpiUpdatedBy")
  kpiDeletedBy       KpiConfig[] @relation("KpiDeletedBy")
  notifications      Notification[]
  createdRecords     ProductionRecord[] @relation("RecordCreatedBy")
  approvedRecords    ProductionRecord[] @relation("RecordApprovedBy")
  reviewedRecords    ProductionRecord[] @relation("RecordReviewedBy")
  lockedRecords      ProductionRecord[] @relation("RecordLockedBy")
  recordVersions     ProductionRecordVersion[] @relation("RecordVersionChangedBy")
  importHistories    ImportHistory[] @relation("ImportImportedBy")
  securityConfigs    SecurityConfig[] @relation("SecurityConfigUpdatedBy")
  sessions           Session[]
  qualityChecksCreated  QualityCheck[] @relation("QualityCheckCreatedBy")
  qualityChecksReviewed QualityCheck[] @relation("QualityCheckReviewedBy")
  qualityChecksApproved QualityCheck[] @relation("QualityCheckApprovedBy")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// active login session — "Manajemen Sesi" (phase 5 backend). tokenHash =
// sha256 hex dari token sesi acak (token mentah TIDAK pernah disimpan; lookup
// sesi via hash). ip + userAgent disimpan mentah; device/browser/os/location
// diparse di layer API/UI (mengurangi kolom duplikat & denormalisasi). isCurrent
// di UI = tokenHash yang cocok dengan token request saat ini (query-time, bukan
// kolom). cleanupExpired (delete expiresAt < now) berjalan via helper/task.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  isRevoked  Boolean   @default(false) @map("is_revoked")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@index([expiresAt])
  @@index([isRevoked])
  @@map("sessions")
}

// percobaan login per-percobaan — dasar RATE LIMIT per-IP + audit login
// terperinci ("Perlindungan Brute-Force", phase 5 backend). Append-only, ditulis
// hanya saat percobaan login (create). email = alamat yang dicoba, sengaja TANPA
// relasi FK ke User: rate limit per-IP berlaku lintas akun & percobaan anonim
// (email tak dikenal) tetap tercatat. success=false dihitung dalam window rate
// limit; success=true menandai window fresh (mirror mock frontend eps_rate_limit).
// Immutability (tanpa UPDATE/DELETE) dijaga di layer API.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  ip        String
  email     String
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, createdAt])
  @@index([email, createdAt])
  @@map("login_attempts")
}

model Role {
  id          String      @id @default(uuid()) @db.Uuid
  name        RoleName    @unique
  description String      @default("")
  userRoles   UserRole[]
  permissions RolePermission[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String   @default("")
  rolePermissions RolePermission[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("permissions")
}

// pivot: User <-> Role (many-to-many)
model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@map("user_roles")
}

// pivot: Role <-> Permission (many-to-many)
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now()) @map("granted_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// production line / work area — future data modules hang off this
model Area {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  lineCode  String?  @unique @map("line_code")
  users     User[]
  productionRecords ProductionRecord[]
  qualityChecks QualityCheck[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("areas")
}

// audit trail — immutable; no update/delete endpoint. userId = actor (nullable).
// Proteksi DB: trigger enforce_history_immutability menolak UPDATE/DELETE
// langsung (lihat prisma/migrations/enforce_history_immutability).
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// brute-force protection settings — "Perlindungan Brute-Force" (phase 5
// backend). KONFIGURASI tunggal: key="brute_force" -> value = {maxAttempts,
// lockoutBaseMs, lockoutMaxMs, rateLimitMaxAttempts, rateLimitWindowMs} (semua
// ms, bukan menit). Admin mengubah via /api/security-config (GET/PUT); login
// menerapkannya via lib/brute-force/config.ts dengan fallback AUTH_CONFIG
// bila tabel kosong. updatedBy = admin terakhir yang mengubah (relasi unik
// "SecurityConfigUpdatedBy", pola sama seperti KpiConfig.updatedBy).
model SecurityConfig {
  id            String    @id @default(uuid()) @db.Uuid
  key           String    @unique
  value         Json
  updatedBy     String?   @map("updated_by") @db.Uuid
  updatedByUser User?     @relation("SecurityConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("security_configs")
}

// KPI configuration — "Pengaturan KPI", phase 1 backend. Soft delete via
// isDeleted/deletedAt; CRUD endpoints filter isDeleted=false. Single KpiConfig
// model holds thresholds (no separate KpiThreshold table): warning/critical
// lower bounds cover the PRD's statuses; add warningHigh/criticalHigh if a
// ceiling KPI (e.g. defect rate) ever needs upper bounds.
model KpiConfig {
  id                String    @id @default(uuid()) @db.Uuid
  key               String    @unique
  name              String
  formula           String
  unit              String
  decimals          Int       @default(2)
  target            Float
  higherIsBetter    Boolean   @default(true) @map("higher_is_better")
  warningThreshold  Float?    @map("warning_threshold")
  criticalThreshold Float?    @map("critical_threshold")
  definition        String?   @map("definition")
  sourceData        String?   @map("source_data")
  isActive          Boolean   @default(true) @map("is_active")
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at")
  updatedBy         String?   @map("updated_by") @db.Uuid
  updatedByUser     User?     @relation("KpiUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  deletedBy         String?   @map("deleted_by") @db.Uuid
  deletedByUser     User?     @relation("KpiDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([isDeleted])
  @@index([key, isDeleted])
  @@map("kpi_configs")
}

// custom per-user dashboard layout — single active layout per user (1:1).
// layoutType DASHBOARD vs TV lets the same model serve TV display mode
// without a second table; TV rows share userId=null so many TV layouts per
// area can be stored later without schema change.
model DashboardLayout {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @unique @map("user_id") @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String     @default("default")
  layout     Json
  theme      Json?
  layoutType LayoutType @default(DASHBOARD) @map("layout_type")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("dashboard_layouts")
}

// in-app notification — per-user (recipientId required, read status on row).
// broadcast (NotificationRecipient pivot) deferred until PRD needs it.
model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  type        NotificationType
  title       String
  message     String
  severity    NotificationSeverity @default(INFO)
  link        String?
  isRead      Boolean             @default(false) @map("is_read")
  readAt      DateTime?           @map("read_at")
  isArchived  Boolean             @default(false) @map("is_archived")
  archivedAt  DateTime?           @map("archived_at")
  recipientId String              @map("recipient_id") @db.Uuid
  recipient   User                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}

// daily production record — "Workflow Status Data", phase 1 backend (schema only).
// status workflow (DRAFT → SUBMITTED → REVIEWED → APPROVED → LOCKED) + transition
// validation handled by the endpoint layer (next task). Audit trail reuses AuditLog
// (entityType "PRODUCTION_RECORD"); version column tracks revision count, and
// ProductionRecordVersion (below) stores the full per-version snapshots for the
// "Riwayat Versi Data" feature.
//
// RAW INPUT (12 fields, from Excel): date, model, shift, uphTarget, uphResult,
// hcStandard, hcActual, plan, outputProd, totalSetup, workingHour,
// totalSetupPacking, workingHourPacking. Calculated fields (gapUph, gapHc, gapOp,
// upph) are STORED, not computed on the fly: values stay consistent with the frozen
// record even if the phase-2 calculation engine changes, and the before/after
// audit diff records them like any other column.
model ProductionRecord {
  id                   String       @id @default(uuid()) @db.Uuid
  date                 DateTime     @db.Date
  model                String
  shift                String?
  areaId               String?      @map("area_id") @db.Uuid
  area                 Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  importHistoryId      String?      @map("import_history_id") @db.Uuid
  importHistory        ImportHistory? @relation(fields: [importHistoryId], references: [id], onDelete: SetNull)

  // raw input
  uphTarget            Float        @map("uph_target")
  uphResult            Float        @map("uph_result")
  hcStandard           Float        @map("hc_standard")
  hcActual             Float        @map("hc_actual")
  plan                 Float
  outputProd           Float        @map("output_prod")
  totalSetup           Float        @map("total_setup")
  workingHour          Float        @map("working_hour")
  totalSetupPacking    Float        @map("total_setup_packing")
  workingHourPacking   Float        @map("working_hour_packing")

  // calculated (stored)
  gapUph               Float        @map("gap_uph")
  gapHc                Float        @map("gap_hc")
  gapOp                Float        @map("gap_op")
  upph                 Float

  // workflow status
  status               RecordStatus @default(DRAFT)
  createdBy            String       @map("created_by") @db.Uuid
  createdByUser        User         @relation("RecordCreatedBy", fields: [createdBy], references: [id])
  approvedBy           String?      @map("approved_by") @db.Uuid
  approvedByUser       User?        @relation("RecordApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  reviewedBy           String?      @map("reviewed_by") @db.Uuid
  reviewedByUser       User?        @relation("RecordReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  lockedBy             String?      @map("locked_by") @db.Uuid
  lockedByUser         User?        @relation("RecordLockedBy", fields: [lockedBy], references: [id], onDelete: SetNull)
  approvedAt           DateTime?    @map("approved_at")
  reviewedAt           DateTime?    @map("reviewed_at")
  lockedAt             DateTime?    @map("locked_at")
  version              Int          @default(1)
  versions             ProductionRecordVersion[]
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@index([date, model, status])
  @@index([status, createdAt])
  @@index([areaId, date])
  @@index([createdBy])
  @@index([model])
  @@index([importHistoryId])
  // one record per model per date/shift per area; nullable shift/areaId columns
  // make Postgres treat NULL as distinct, so the constraint only fully enforces
  // when both are set — dedupe for null-shift/null-area imports lives in the
  // import layer (phase 2).
  @@unique([date, model, shift, areaId])
  @@map("production_records")
}

// import history — one row per CSV/Excel import batch (fase impor). errors =
// snapshot laporan per-baris [{rowIndex, errors}] utk endpoint laporan; createdAt
// = waktu impor. Rollback memakai relasi records (hapus record yang berasal dari
// import ini — hanya yang masih DRAFT).
model ImportHistory {
  id         String        @id @default(uuid()) @db.Uuid
  fileName   String        @map("file_name")
  rowsTotal  Int           @map("rows_total")
  rowsValid  Int           @map("rows_valid")
  rowsSkipped Int          @default(0) @map("rows_skipped")
  status     ImportStatus  @default(SUCCESS)
  errors     Json?
  importedBy String        @map("imported_by") @db.Uuid
  importedByUser User      @relation("ImportImportedBy", fields: [importedBy], references: [id])
  records    ProductionRecord[]
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([importedBy])
  @@index([status, createdAt])
  @@map("import_histories")
}

// revision history for production records — "Riwayat Versi Data". One row per
// CREATED/UPDATED/CORRECTED mutation. snapshot = full record state (raw +
// calculated + status) captured at the new version, so every revision is
// independently restorable. version always matches the record's version column
// and the record's version increments on each mutation → (recordId, version)
// is unique; no two snapshots can collide. Before-state diff for the UI still
// comes from AuditLog.before.
// Proteksi DB: trigger enforce_history_immutability menolak UPDATE/DELETE
// langsung (lihat prisma/migrations/enforce_history_immutability).
model ProductionRecordVersion {
  id            String           @id @default(uuid()) @db.Uuid
  recordId      String           @map("record_id") @db.Uuid
  record        ProductionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  changedBy     String           @map("changed_by") @db.Uuid
  changedByUser User             @relation("RecordVersionChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)
  changeReason  String?          @map("change_reason")
  action        String
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([recordId, version])
  @@index([recordId, createdAt])
  @@map("production_record_versions")
}

// monitoring — "Monitoring & Backup" (phase 1 backend, schema only).
// HealthCheck: one row per probe, append-only history for the database health
// dashboard. details = per-check result map from the probe runner. Metrics like
// uptime % and avg response time are computed in queries, not stored.
model HealthCheck {
  id            String       @id @default(uuid()) @db.Uuid
  status        HealthStatus
  responseTimeMs Int?        @map("response_time_ms")
  details       Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("health_checks")
}

// one row per backup attempt — the backup history ledger. Current on-disk state
// is resolved at recovery time from path + latest SUCCESS row. triggeredBy is a
// free string (cron, UI, CLI) — no User relation, backups can be unattended.
model BackupRun {
  id          String       @id @default(uuid()) @db.Uuid
  status      BackupStatus
  type        BackupType
  sizeBytes   BigInt?      @map("size_bytes")
  path        String?
  startedAt   DateTime     @map("started_at")
  finishedAt  DateTime?    @map("finished_at")
  error       String?
  triggeredBy String?      @map("triggered_by")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("backup_runs")
}

// slow query ledger — written by the $on("query") hook in lib/prisma.ts for
// queries over SLOW_QUERY_THRESHOLD_MS. Aggregates (avg duration per query
// pattern) are computed on demand, not stored. metadata = params + target from
// the query event.
model SlowQueryLog {
  id         String   @id @default(uuid()) @db.Uuid
  query      String?
  durationMs Int      @map("duration_ms")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([durationMs])
  @@map("slow_query_logs")
}

// quality inspection check — "Modul Quality", phase 2 backend (schema only).
// date = TEXT (string YYYY-MM-DD, sama dengan model produksi fase impor);
// workflow status reuse RecordStatus (DRAFT → SUBMITTED → REVIEWED → APPROVED →
// LOCKED). Audit trail reuses AuditLog (entityType "QUALITY_CHECK").
model QualityCheck {
  id           String       @id @default(cuid())
  date         String
  model        String
  shift        String?
  areaId       String?    @map("area_id") @db.Uuid
  inspectedQty Int
  passedQty    Int
  failedQty    Int
  defectCount  Int
  note         String?
  status       RecordStatus @default(DRAFT)
  version      Int          @default(1)
  createdById  String?    @db.Uuid
  reviewedById String?    @db.Uuid
  approvedById String?    @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  area         Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("QualityCheckCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy   User?        @relation("QualityCheckReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("QualityCheckApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  defects      QualityDefect[]

  @@unique([date, model, shift, areaId])
  @@index([date, model])
  @@index([status])
}

// defect line item per check — "Modul Quality". CASCADE on check delete.
model QualityDefect {
  id         String       @id @default(cuid())
  checkId    String
  defectCode String
  defectName String
  quantity   Int
  createdAt  DateTime     @default(now())
  check      QualityCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@index([defectCode])
}
